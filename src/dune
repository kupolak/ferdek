; Kod w podfolderach: language (składnia i wczytywanie), interpreter, compiler (C i runtime),
; graphics (X11), tools (--check, formatter, LSP, DAP, debugger), cli (komenda ferdek).
; Reguły generujące moduły są w dune każdego podfolderu.
(include_subdirs unqualified)

(library
 (name ferdek_lib)
 (wrapped false)
 (flags
  (:standard -w -27-32))
 (modules :standard \ ferdek)
 (libraries unix str menhirLib yojson)
 (foreign_stubs
  (language c)
  (names graphics_stubs graphics_x11)
  ; XQuartz (/opt/X11) albo Homebrew (/opt/homebrew, /usr/local); na Linuksie ścieżki systemowe
  ; FERDEK_X11_DLOPEN: nagłówki X11 są potrzebne do budowania, ale libX11 ładuje się dopiero przy otwarciu okna
  (flags -DFERDEK_X11_DLOPEN -I/opt/X11/include -I/opt/homebrew/include -I/usr/local/include))
 (c_library_flags (-ldl)))

(executable
 (name ferdek)
 (modules ferdek)
 (flags
  (:standard -w -27-32))
 (libraries ferdek_lib))
