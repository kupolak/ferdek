; ponytail: -ml omija limit tabel ocamllex ("automaton is too big")
(rule
 (targets lexer.ml)
 (deps lexer.mll)
 (action (run ocamllex -ml -q %{deps})))

; Kod grafiki X11 osadzony w kompilatorze - dołączany do programów, które rysują
(rule
 (targets graphics_source.ml)
 (deps graphics_x11.h graphics_x11.c)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "let header = {ferdek_c|")
    (cat graphics_x11.h)
    (echo "|ferdek_c}\nlet code = {ferdek_c|")
    (cat graphics_x11.c)
    (echo "|ferdek_c}\n")))))

(menhir
 (modules parser)
 (flags (--explain --table)))

(library
 (name ferdek_lib)
 (wrapped false)
 (flags
  (:standard -w -27-32))
 (modules
  ast
  parser
  lexer
  preprocessor
  value
  eval
  interp_builtins
  interp_builtins_doom
  interpreter
  compiler
  checker
  graphics_source
  formatter
  syntax_errors
  qualify
  keyword_docs
  source
  sources
  debugger
  dap
  consts
  typy
  lsp
  builtins_string
  builtins_hashmap
  builtins_file
  builtins_list
  errors)
 (libraries unix str menhirLib yojson)
 (foreign_stubs
  (language c)
  (names graphics_stubs graphics_x11)
  ; XQuartz (/opt/X11) albo Homebrew (/opt/homebrew, /usr/local); na Linuksie ścieżki systemowe
  (flags -I/opt/X11/include -I/opt/homebrew/include -I/usr/local/include))
 (c_library_flags (-L/opt/X11/lib -L/opt/homebrew/lib -L/usr/local/lib -lX11)))

(executable
 (name ferdek)
 (modules ferdek)
 (flags
  (:standard -w -27-32))
 (libraries ferdek_lib))


