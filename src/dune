 (libraries unix str menhirLib)
 (foreign_stubs
  (language c)
  (names graphics_stubs graphics_x11)
  (flags -I/opt/X11/include))
 (c_library_flags (-L/opt/X11/lib -lX11)))

(executable
 (name ferdek)
 (modules ferdek)
 (flags
  (:standard -w -27-32))
 (libraries ferdek_lib))


